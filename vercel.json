{
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "Origin-Agent-Cluster", "value": "?1" },
    { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
  ] }],
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api/published-page?slug=:slug"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/index.html"
    }
  ]
}
